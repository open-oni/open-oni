{
  {$CADDY_DEBUG:}
}

# Optional extra top-level listeners. Drop a `*.server.caddyfile` file into the
# caddy-conf volume to enable one. The bot-protection setup uses this to add an
# internal-only ":8081" listener that a challenge proxy (TPS or Anubis) forwards
# to after a visitor passes.
import /etc/caddy/conf.d/*.server.caddyfile

:80 {
  # Custom site-level rules (bot-protection handling, sitemap routes, etc.)
  # should be put into `*.site.caddyfile` files. For rules that are exact
  # matches with the core rules (below), whatever is first gets priority,
  # meaning these custom rules will be evaluated instead of the defaults.
  import /etc/caddy/conf.d/*.site.caddyfile

  # All routing rules are externally imported so that when bot protection is
  # set up, the routes are the same for the main listener or the internal
  # "challenge succeeded" listener.
  import /etc/caddy/oni-routing.caddyfile

  # Everything not caught by other rules goes to ONI directly
  reverse_proxy http://app:8000

  log http-public-access {
    level INFO
  }
}
