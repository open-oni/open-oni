### Mandatory settings ###

# This will be the URL you use to connect to ONI
ONI_BASE_URL=http://localhost:12345

# FILL THESE IN. They're blank so you get punished if you don't.
ONI_SECRET_KEY=
DB_PASSWORD=

ONI_SHORT_PROJECT_NAME="State News"
ONI_LONG_PROJECT_NAME="Historic State Newspaper Preservation Project"

### Optional settings ###

# A value of '1' enables django debug output to the browser and turns off some
# caching. Do *not* turn this on in production!
ONI_DEBUG=0

# Generally the defaults for these are fine
ONI_LOG_LEVEL=INFO
ONI_LOG_TO_FILE=1
ONI_LOG_SQL=0

# CADDY_DEBUG must be "debug" or blank
CADDY_DEBUG=debug

# gunicorn: defaults are okay, but may need to differ *a lot* in different
# environments. Consider overriding workers to be double your vCPUs. Max
# requests at 10k is usually fine.
GUNICORN_WORKERS=4
GUNICORN_MAX_REQUESTS=10000

###
# Bot protection settings: these have no effect unless you enable the
# corresponding compose service
###

# This must be "false" for non-https, but set it to "true" for production where
# you have SSL in front of ONI.
ANUBIS_COOKIE_SECURE=false

# Anubis challenge difficulty: too high and mobile browsers will suffer; too
# low and bots can pass it easily. The default of 4 seems reasonable for now.
ANUBIS_DIFFICULTY=4

# Change Anubis log verbosity
ANUBIS_LOG_LEVEL=INFO

# Keys for Cloudflare's Turnstile widget; sign up to Cloudflare in order to get
# your own keys, or use the test keys below
TPS_SITE_KEY=""
TPS_SECRET_KEY=""

# TPS JWT signing key needs to be kept secret and unique so bots can't fake
# having already passed your challenge
TPS_JWT_KEY="secret and unique"

# Optional configuration to tune how aggressive TPS is. See TPS documentation
# for this stuff. Very generous values are shown here (and baked into the
# `tps.compose.yaml` environment when nothing is set)
#TPS_TOKEN_LIFETIME=24h
#TPS_TOKEN_REQUEST_BUDGET=5000
#TPS_TOKEN_IP_SWITCH_COST=50

### Turnstile test key reference

# Turnstile site key (public, shown in the challenge widget). Cloudflare offers
# test keys that force a fixed outcome:
#
#TPS_SITE_KEY="1x00000000000000000000AA" # Always passes, visible
#TPS_SITE_KEY="2x00000000000000000000AB" # Always fails, visible
#TPS_SITE_KEY="1x00000000000000000000BB" # Always passes, invisible
#TPS_SITE_KEY="2x00000000000000000000BB" # Always fails, invisible
#TPS_SITE_KEY="3x00000000000000000000FF" # Force interactive challenge, visible

# Turnstile secret key (used to validate a challenge response). Test values:
#
#TPS_SECRET_KEY="1x0000000000000000000000000000000AA" # Always passes validation
#TPS_SECRET_KEY="2x0000000000000000000000000000000AA" # Always fails validation
